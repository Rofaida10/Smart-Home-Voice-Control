# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it.

# Communication mode: SERIAL or SUPABASE
COMMUNICATION_MODE=SUPABASE

# Supabase project URL (no trailing slash)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase API key (anon or service-role key)
SUPABASE_KEY=your-supabase-key

# Device ID must match the firmware DEVICE_ID in communication_config.h
DEVICE_ID=esp32-001
